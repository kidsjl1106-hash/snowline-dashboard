      "icons": [{ "src": "/snowline-dashboard/assets/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "재고 위험",
      "short_name": "재고",
      "url": "/snowline-dashboard/?view=inventory-risk&source=shortcut",
      "icons": [{ "src": "/snowline-dashboard/assets/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "고객상담",
      "short_name": "CS",
