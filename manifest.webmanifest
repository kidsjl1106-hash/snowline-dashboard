{
  "id": "/snowline-dashboard/",
  "name": "SNOWLINE Sales Dashboard",
  "short_name": "SNOWLINE",
  "description": "SNOWLINE internal sales dashboard",
  "lang": "ko-KR",
  "start_url": "/snowline-dashboard/?source=pwa",
  "scope": "/snowline-dashboard/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "theme_color": "#0f172a",
  "background_color": "#ffffff",
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "/snowline-dashboard/assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/snowline-dashboard/assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/snowline-dashboard/assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "통합 현황",
      "short_name": "현황",
